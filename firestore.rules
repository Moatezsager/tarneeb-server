rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(roomId) {
      return signedIn() && get(/databases/$(database)/documents/rooms/$(roomId)).data.protocolVersion == 2
        && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberUids;
    }
    // All mutations go through the authenticated, validated server transactions.
    // Legacy rooms are deliberately unreadable: they may contain passwords and all hands.
    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      match /friends/{friendId} { allow read: if signedIn() && request.auth.uid == uid; }
    }
    match /rankedStats/{uid} { allow get: if signedIn() && request.auth.uid == uid; }
    match /friendRequests/{id} {
      allow read: if signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }
    match /roomInvites/{id} {
      allow read: if signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }
    match /rooms/{roomId} { allow get: if member(roomId); }
    match /{document=**} { allow read, write: if false; }
  }
}
